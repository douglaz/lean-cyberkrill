import Bitcoin.Amount

namespace Bitcoin.Amount

/-- ASCII decimal digits only. No exponent, sign, separator or whitespace. -/
def digitValue (c : Char) : Option Nat :=
  if c.isDigit then some (c.toNat - '0'.toNat) else none

def digit (n : Nat) : Char := Char.ofNat (48 + n % 10)

theorem digit_facts (n : Nat) :
    digitValue (digit n) = some (n % 10) ∧ (digit n).isDigit = true ∧ digit n ≠ '.' := by
  have all : ∀ m : Fin 10,
      digitValue (digit m.val) = some m.val ∧
      (digit m.val).isDigit = true ∧ digit m.val ≠ '.' := by decide
  have h := all ⟨n % 10, Nat.mod_lt _ (by decide)⟩
  simpa only [digit, Nat.mod_mod] using h

/-- Scan least-significant characters first. The flag records the decimal point;
the exponent counts digits encountered after that point in this reversed scan. -/
def scanRev : List Char → Option (Decimal × Bool)
  | [] => some (⟨0, 0⟩, false)
  | c :: cs => do
      let (d, point) ← scanRev cs
      if c = '.' then
        if point then none else some (⟨d.mantissa, 0⟩, true)
      else
        let r ← digitValue c
        some (⟨r + 10 * d.mantissa, if point then d.exponent + 1 else 0⟩, point)

def parseDecimal (s : String) : Option Decimal :=
  let cs := s.toList.reverse
  if cs.any Char.isDigit then (scanRev cs).map Prod.fst else none

def parseScaled (s : String) (k : Nat) : Option Amount :=
  (parseDecimal s).bind (fun d => ofDecimal d k)

def parseBtc (s : String) : Option Amount := parseScaled s 11
def parseSats (s : String) : Option Amount := parseScaled s 3

/-- Integer msat syntax stays unbounded, unlike the CLI's u64 branch. -/
def parseMsat (s : String) : Option Amount :=
  if s.toList.all Char.isDigit then parseScaled s 0 else none

def digitsRev (n : Nat) : List Char :=
  if n < 10 then [digit n] else digit n :: digitsRev (n / 10)
termination_by n

/-- A fixed decimal point, followed in the reversed representation by the
integral digits. Leading fractional zeroes are generated by the width. -/
def fixedRev (n : Nat) : Nat → List Char
  | 0 => '.' :: digitsRev n
  | k + 1 => digit n :: fixedRev (n / 10) k

/-- Remove zero fractional digits by value before writing a fixed decimal. -/
def printRev (n : Nat) : Nat → List Char
  | 0 => digitsRev n
  | k + 1 =>
      if n % 10 = 0 then printRev (n / 10) k else fixedRev n (k + 1)

def printScaled (a : Amount) (k : Nat) : String :=
  String.ofList (printRev a.msat k).reverse

def printBtc (a : Amount) : String := printScaled a 11
def printSats (a : Amount) : String := printScaled a 3
def printMsat (a : Amount) : String := printScaled a 0

theorem scanRev_digit (n : Nat) (cs : List Char) (d : Decimal) (p : Bool)
    (h : scanRev cs = some (d, p)) :
    scanRev (digit n :: cs) =
      some (⟨n % 10 + 10 * d.mantissa, if p then d.exponent + 1 else 0⟩, p) := by
  simp [scanRev, h, (digit_facts n).1, (digit_facts n).2.2]

theorem scanRev_digitsRev (n : Nat) :
    scanRev (digitsRev n) = some (⟨n, 0⟩, false) := by
  rw [digitsRev]
  split
  · rename_i h
    simp [scanRev, (digit_facts n).1, (digit_facts n).2.2,
      Nat.mod_eq_of_lt h]
  · rw [scanRev_digit n _ _ _ (scanRev_digitsRev (n / 10))]
    dsimp only
    rw [Nat.mod_add_div]
    rfl
termination_by n

theorem digitsRev_hasDigit (n : Nat) : (digitsRev n).any Char.isDigit = true := by
  rw [digitsRev]
  split <;> simp [(digit_facts n).2.1]

theorem digitsRev_allDigits (n : Nat) : (digitsRev n).all Char.isDigit = true := by
  rw [digitsRev]
  split
  · simp [(digit_facts n).2.1]
  · simp [(digit_facts n).2.1, digitsRev_allDigits (n / 10)]
termination_by n

theorem scanRev_fixedRev (n k : Nat) :
    scanRev (fixedRev n k) = some (⟨n, k⟩, true) := by
  induction k generalizing n with
  | zero => simp [fixedRev, scanRev, scanRev_digitsRev]
  | succ k ih =>
    rw [fixedRev, scanRev_digit n _ _ _ (ih (n / 10))]
    dsimp only
    rw [Nat.mod_add_div]
    rfl

theorem fixedRev_hasDigit (n k : Nat) : (fixedRev n k).any Char.isDigit = true := by
  cases k <;> simp [fixedRev, digitsRev_hasDigit, (digit_facts n).2.1]

theorem printRev_hasDigit (n k : Nat) : (printRev n k).any Char.isDigit = true := by
  induction k generalizing n with
  | zero => exact digitsRev_hasDigit n
  | succ k ih =>
    simp only [printRev]
    split
    · exact ih _
    · exact fixedRev_hasDigit _ _

/-- Printing at scale k preserves the rational value despite zero trimming. -/
theorem scanRev_printRev (n k : Nat) :
    ∃ d p, scanRev (printRev n k) = some (d, p) ∧
      n * 10^d.exponent = d.mantissa * 10^k := by
  induction k generalizing n with
  | zero => exact ⟨⟨n, 0⟩, false, scanRev_digitsRev n, rfl⟩
  | succ k ih =>
    simp only [printRev]
    split
    · rename_i h
      obtain ⟨d, p, hd, he⟩ := ih (n / 10)
      refine ⟨d, p, hd, ?_⟩
      have hn : n = (n / 10) * 10 := by omega
      rw [hn, Nat.pow_succ, Nat.mul_assoc, Nat.mul_comm 10,
        ← Nat.mul_assoc, he, Nat.mul_assoc]
    · exact ⟨⟨n, k + 1⟩, true, scanRev_fixedRev n (k + 1), rfl⟩

theorem parseScaled_printScaled (a : Amount) (k : Nat) :
    parseScaled (printScaled a k) k = some a := by
  obtain ⟨d, p, hd, he⟩ := scanRev_printRev a.msat k
  simp only [parseScaled, parseDecimal, printScaled, String.toList_ofList, List.reverse_reverse,
    printRev_hasDigit, ite_true, hd, Option.map_some, Option.bind_some]
  exact (ofDecimal_iff d k a).mpr he

theorem parseBtc_printBtc (a : Amount) : parseBtc (printBtc a) = some a :=
  parseScaled_printScaled a 11

theorem parseSats_printSats (a : Amount) : parseSats (printSats a) = some a :=
  parseScaled_printScaled a 3

theorem parseMsat_printMsat (a : Amount) : parseMsat (printMsat a) = some a := by
  have all : (printMsat a).toList.all Char.isDigit = true := by
    simp [printMsat, printScaled, printRev, digitsRev_allDigits]
  simp only [parseMsat, all, ite_true]
  exact parseScaled_printScaled a 0

theorem parseScaled_submsat (s : String) (k : Nat) (d : Decimal)
    (hs : parseDecimal s = some d) (h : ¬ 10^d.exponent ∣ d.mantissa * 10^k) :
    parseScaled s k = none := by
  simp [parseScaled, hs, ofDecimal_submsat d k h]

theorem parseScaled_exact (s : String) (k : Nat) (a : Amount)
    (h : parseScaled s k = some a) :
    ∃ d, parseDecimal s = some d ∧ a.msat * 10^d.exponent = d.mantissa * 10^k := by
  cases hs : parseDecimal s with
  | none => simp [parseScaled, hs] at h
  | some d =>
    exact ⟨d, rfl, (ofDecimal_iff d k a).mp (by simpa [parseScaled, hs] using h)⟩

theorem parseBtc_submsat (s : String) (d : Decimal) (hs : parseDecimal s = some d)
    (h : ¬ 10^d.exponent ∣ d.mantissa * 10^11) : parseBtc s = none :=
  parseScaled_submsat s 11 d hs h

theorem parseSats_submsat (s : String) (d : Decimal) (hs : parseDecimal s = some d)
    (h : ¬ 10^d.exponent ∣ d.mantissa * 10^3) : parseSats s = none :=
  parseScaled_submsat s 3 d hs h

theorem parseBtc_exact (s : String) (a : Amount) (h : parseBtc s = some a) :
    ∃ d, parseDecimal s = some d ∧ a.msat * 10^d.exponent = d.mantissa * 10^11 :=
  parseScaled_exact s 11 a h

theorem parseSats_exact (s : String) (a : Amount) (h : parseSats s = some a) :
    ∃ d, parseDecimal s = some d ∧ a.msat * 10^d.exponent = d.mantissa * 10^3 :=
  parseScaled_exact s 3 a h

end Bitcoin.Amount
